{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tapp/tapp-filament-starter-kit",
    "type": "project",
    "description": "Opinionated Laravel 13 and Filament 5 starter kit from Tapp Network.",
    "keywords": ["laravel", "filament", "starter-kit", "tapp"],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "aws/aws-sdk-php": "^3.399",
        "filament/filament": "^5.7.6",
        "filament/spatie-laravel-media-library-plugin": "^5.7.6",
        "laravel/framework": "^13.24.0",
        "laravel/nightwatch": "^1.28.6",
        "nunomaduro/essentials": "^1.2.0",
        "owen-it/laravel-auditing": "^14.0.6",
        "rappasoft/laravel-authentication-log": "^6.1.1",
        "spatie/laravel-medialibrary": "^11.23.5",
        "spatie/laravel-permission": "^6.25",
        "stechstudio/filament-impersonate": "^5.6",
        "tapp/filament-auditing": "^4.0.9",
        "tapp/filament-authentication-log": "^5.0.6",
        "tapp/filament-footer": "^1.0.3",
        "tapp/filament-invite": "^2.2",
        "tapp/filament-maillog": "^2.2.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.5.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.3",
        "laravel/pint": "^1.30.5",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7.2|^5.1",
        "pestphp/pest-plugin-browser": "^4.3.1|^5.0.1",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0.1",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.4|^5.0.2",
        "rector/rector": "^2.6.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "bun run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0",
        "test:types": "phpstan",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@php artisan key:generate --ansi",
                    "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
                    "@php artisan migrate --graceful --ansi"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
